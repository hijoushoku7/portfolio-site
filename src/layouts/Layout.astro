---
import Loader from '../components/Loader.astro';
import Curtain from '../components/Curtain.astro';
import {Font} from 'astro:assets';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
    <meta name="description" content="hijoushokuのホームページです。" />
		<link rel="icon" type="image/svg+xml" href="/works/icon.avif" />
		<link rel="icon" href="/works/icon.avif" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#525252" />
		<Font cssVariable="--font-zen-kaku" />
		<Font cssVariable="--font-dotgothic16" />
		
		<link
			rel="preload"
			href="/fonts/MinecraftiaRegular.ttf"
			as="font"
			type="font/ttf"
			crossorigin
		/>
		<style is:inline>
			@font-face {
				font-family: 'Minecraftia';
				src: url('/fonts/MinecraftiaRegular.ttf') format('truetype');
				font-weight: normal;
				font-style: normal;
				font-display: block;
			}
		</style>
		<title>Hijoushokuのホームページ</title>
	</head>
	<body>
		<Loader />
		<Curtain />
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
