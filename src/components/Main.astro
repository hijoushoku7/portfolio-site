---

<Nav />

<main>
	<Hero name={name} title={title} affiliation={affiliation}/>

	<div class="content">
		<Section id="about" heading="About">
			<p>
				こんにちは。非常食がニックネームの大学生です。本名は怖いので書きません。技術が大好きで、大学でのコンピューターサイエンス学習に加えてサーバーやWEB周りの技術を中心に学んでいます。
				趣味は自作キーボード、ゲーム、古着などです。上は初めて作成したキーボードです。ついでに小さい頃にフランスに住んでいたため、フランス語が話せます。英語もスピーキングは得意です。
			</p>
		</Section>

		<Section id="affiliation" heading="Affiliation/所属">
			<div class="affiliation__list">
				{affiliations.map((a) => (
					<div class="affiliation__item">
						<h3 class="affiliation__name">{a.name}</h3>
						<p class="affiliation__meta">{a.role}・{a.period}</p>
						<p class="affiliation__desc">{a.description}</p>
					</div>
				))}
			</div>
		</Section>

		<Section id="works" heading="Works/制作物">
			<div class="works__grid">
				{projects.map((p, i) => (
					<ProjectCard
						id={`work-${i}`}
						title={p.title}
						description={p.description}
						tags={p.tags}
						overview={p.overview}
						issue={p.issue}
						solution={p.solution}
						images={p.images}
					/>
				))}
			</div>
		</Section>

		<Section id="activities" heading="Activities/活動">
			<div class="activities__list">
				{activities.map((a) => (
					<div class="activities__item">
						<h3 class="activities__title">{a.title}</h3>
						<p class="activities__meta">{a.date}・{a.result}</p>
						<p class="activities__desc">{a.description}</p>
					</div>
				))}
			</div>
		</Section>

		<Section id="qualifications" heading="Qualifications/資格">
			{qualifications.length > 0 ? (
				<div class="qualifications__list">
					{qualifications.map((qualification) => (
						<QualificationItem
							name={qualification.name}
							acquiredAt={qualification.acquiredAt}
							issuer={qualification.issuer}
						/>
					))}
				</div>
			) : (
				<p class="qualifications__empty">資格情報は準備中です。</p>
			)}
		</Section>

		<Section id="skills" heading="Skills/スキル">
			{skillCategories.map((cat) => (
				<div class="skills__cat">
					<h3 class="skills__cat-name">{cat.name}</h3>
					<div class="skills__grid">
						{cat.skills.map((s) => (
							<SkillBlock
								icon={s.icon}
								label={s.label}
							/>
						))}
					</div>
				</div>
			))}
		</Section>

		<Section id="contact" heading="Contact/連絡先">
			<p>
				<button class="link mail-copy-btn" data-email="hijoushoku88@gmail.com">hijoushoku88@gmail.com</button>
			</p>
		</Section>
	</div>

	<Footer />
</main>

<CopyToast />

<style is:global>
	:root {
		/* メインカラー＝グレー2トーン（純白/純黒を避ける） */
		--color: #525252; /* 前景・テキスト・枠線（ダークグレー） */
		--paper: #e6e6e6; /* カード/ラベルの地（ライトグレー、旧ベージュの代わり） */
		--edge: #cfcfcf; /* 1pxの薄い縁取り */

		/* DESIGN.md 第4章の二重シャドウ（グレー版） */
		--shadow-2: 1px 1px 0 var(--edge), 6px 6px 0 rgba(82, 82, 82, 0.25);
		--shadow-2-hover: 1px 1px 0 var(--edge), 8px 8px 0 rgba(82, 82, 82, 0.25);
		--shadow-2-active: 1px 1px 0 var(--edge), 3px 3px 0 rgba(82, 82, 82, 0.25);

		--font-pixel: 'Minecraftia', var(--font-dotgothic16);
		--font-body: var(--font-zen-kaku);
	}

	* {
		box-sizing: border-box;
	}

	body {
		margin: 0;
		color: var(--color);
		font-family: var(--font-body);
		background-color: #b8b8b8; /* 画像読込前/余白のフォールバック（グレー） */
	}

	/* 背景画像レイヤー：最背面に固定（旧 background-attachment: fixed 相当） */
	body::before {
		content: '';
		position: fixed;
		inset: 0;
		z-index: -2;
		background: url('/mainBackground.avif') center / cover no-repeat;
	}

	/* ベールレイヤー：mainBackground.avif の上に paper.avif を重ねる。
	   opacity は JS がスクロール量から算出して --veil に設定する。
	   スクロール最上部(0)では透明＝mainBackground.avif が見え、
	   Works セクションに到達した時点でほぼ paper.avif 一色（0.97）になる。 */
	body::after {
		content: '';
		position: fixed;
		inset: 0;
		z-index: -1;
		background: url('/paper.avif') center / cover no-repeat;
		opacity: var(--veil, 0);
		pointer-events: none;
	}

	/* ラベルタグ風の見出し：背景色を塗ってネガ表示（DESIGN.md 第3章） */
	.label {
		display: inline-block;
		font-family: var(--font-pixel);
		color: var(--paper);
		background: var(--color);
		padding: 0.4rem 0.7rem;
		margin: 0;
		line-height: 1.2;
		box-shadow: var(--shadow-2);
	}

	/* 本文リンクのホバー（持ち上がる挙動） */
	button.link {
		border: none;
		cursor: pointer;
	}
	.link {
		font-family: var(--font-body);
		color: var(--color);
		background: var(--paper);
		text-decoration: none;
		padding: 0.15rem 0.4rem;
		box-shadow: var(--shadow-2);
		transition: transform 0.3s, box-shadow 0.3s;
		display: inline-block;
	}
	.link:hover {
		transform: scale(1.1);
		box-shadow: var(--shadow-2-hover);
	}
</style>

<!-- ▼ このコンポーネント固有のスタイル（スコープ付き） -->
<style>
	/* 本文セクション。背景は body::after（paper.avif のベール層）が
	   スクロール量に応じて現れるため、ここは透明にしておく。 */
	.content {
		border-top: 2px dashed var(--color);
		border-bottom: 2px dashed var(--color);
	}

	.works__grid {
		display: grid;
		gap: 1.2rem;
	}

	/* 所属・Activities：共通のリスト見た目（破線区切りのシンプルな一覧） */
	.affiliation__list,
	.activities__list,
	.qualifications__list {
		display: grid;
		gap: 1.2rem;
	}
	.affiliation__item,
	.activities__item {
		padding-bottom: 1.2rem;
		border-bottom: 1px dashed var(--edge);
	}
	.affiliation__item:last-child,
	.activities__item:last-child {
		padding-bottom: 0;
		border-bottom: none;
	}
	.affiliation__name,
	.activities__title {
		font-family: var(--font-pixel);
		font-size: 1rem;
		margin: 0 0 0.4rem;
	}
	.affiliation__meta,
	.activities__meta {
		font-family: var(--font-pixel);
		font-size: 0.86rem;
		opacity: 0.7;
		margin: 0 0 0.5rem;
	}
	.affiliation__desc,
	.activities__desc {
		font-size: 0.9rem;
		line-height: 1.7;
		margin: 0;
	}

	.qualifications__empty {
		font-size: 0.9rem;
		margin: 0;
	}

	.skills__cat {
		margin-bottom: 1.8rem;
	}
	.skills__cat:last-child {
		margin-bottom: 0;
	}
	.skills__cat-name {
		font-family: var(--font-pixel);
		font-size: 0.75rem;
		letter-spacing: 0.08em;
		color: var(--paper);
		background: var(--color);
		display: inline-block;
		padding: 0.2rem 0.5rem;
		margin: 0 0 0.8rem;
	}

	.skills__grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
		gap: 0.7rem;
	}
</style>

<script>
	document.querySelectorAll<HTMLButtonElement>('.mail-copy-btn').forEach((btn) => {
		btn.addEventListener('click', () => {
			const email = btn.dataset.email ?? '';
			navigator.clipboard.writeText(email).then(() => {
				window.dispatchEvent(new CustomEvent('copy-toast'));
			});
		});
	});

	const MAX = 0.97; // 最大の白さ（1で完全にグレー一色）

	function update() {
		const about = document.querySelector<HTMLElement>('#about');
		if (!about) return;
		// About の開始位置までスクロールしたら MAX に到達させる
		const target = about.offsetTop -300;
		const p = target > 0 ? Math.min(window.scrollY / target, 1) : 1;
		document.documentElement.style.setProperty('--veil', String(p * MAX));
	}

	addEventListener('scroll', update, { passive: true });
	addEventListener('resize', update);
	update();

	// 制作物カードを監視し、画面内に入ったら .is-animated を付与してフェードイン
	const cards = document.querySelectorAll('.card');
	const cardObserver = new IntersectionObserver((entries) => {
		entries.forEach((entry) => {
			if (entry.isIntersecting) {
				entry.target.classList.add('is-animated');
				cardObserver.unobserve(entry.target); // 一度だけ発火
			}
		});
	}, { threshold: 0.2 });
	cards.forEach((card) => cardObserver.observe(card));
</script>
